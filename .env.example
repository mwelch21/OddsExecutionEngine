APP_NAME=Odds Execution Engine
APP_ENV=development
APP_HOST=0.0.0.0

# --- Host ports -------------------------------------------------------------
# Every published port is configurable so two worktrees can run their stacks at
# the same time. These defaults are "slot 0": the values this repo has always
# used. A checkout with no .env at all gets exactly these, so nothing about the
# normal single-stack workflow changes.
#
# scripts/new-worktree.sh probes for the first free slot and writes the result
# into the new worktree's .env. Slot N adds N*100 to the api port, N*100 to the
# frontend port, and N*100 to the Postgres host port.
#
#   slot 0    8000 / 5173 / 5433
#   slot 1    8100 / 5273 / 5533
#   slot 2    8200 / 5373 / 5633
APP_PORT=8000
FRONTEND_PORT=5173
# Host port for the Docker Postgres. The container port never changes.
POSTGRES_HOST_PORT=5433

POSTGRES_DB=odds_execution
POSTGRES_USER=app
# Local development only. Use a unique secret in production.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Sized for hand-driven refresh. Tighten once something refreshes on a schedule.
OPPORTUNITY_TTL_MINUTES=720
# 0 disables provider response reuse.
PROVIDER_CACHE_TTL_SECONDS=300

# --- The Odds API -----------------------------------------------------------
# Upstream bills CREDITS, not requests: cost = [markets] x [regions] per call.
# The settings below cost 3 credits per call (3 markets x 1 region).
#
# ODDS_API_SPORTS only gates the PER-EVENT refresh loop, which walks every entry
# in it -- so N sports here means N calls, 3N credits, to refresh one event. Keep
# it to one in-season sport. Sport-wide refresh takes its sport from the request
# body, so the UI can turn on any supported sport without touching this.
# Supported keys live in SPORT_LEAGUE_MAP in odds_api_provider.py.
ODDS_API_KEY=
ODDS_API_SPORTS=americanfootball_nfl
ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h,spreads,totals
