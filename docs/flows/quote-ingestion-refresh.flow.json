    ],
    "tests": [
      { "name": "test_quote_ingestion", "path": "backend/tests/test_quote_ingestion.py" }
    ],
    "endpoints": [
      { "name": "POST /ingestion/quotes/refresh", "path": "backend/app/api/quote_ingestion_router.py" }
    ]
  }
}
