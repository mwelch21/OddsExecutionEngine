{
  "id": "quote-ingestion-refresh",
  "name": "Quote ingestion refresh",
  "last_updated": "2026-08-25",
  "updated_by": "claude-code",
  "trigger": "POST /ingestion/quotes/refresh with event_id",

  "services": [
    {
      "id": "quote-ingestion-service",
      "name": "QuoteIngestionService",
      "role": "Orchestrates provider fetch, normalization, persistence, and event publishing",
      "entry_point": "backend/app/application/quote_ingestion_service.py:refresh_quotes()",
      "package": "backend/app/application",
      "states_owned": ["provider_quotes_fetched", "events_published"]
    },
    {
      "id": "in-memory-quote-provider",
      "name": "InMemoryQuoteProvider",
      "role": "Supplies raw quotes for the given event from fixture data",
      "entry_point": "backend/app/infrastructure/quote_provider.py:list_quotes()",
      "package": "backend/app/infrastructure",
      "states_owned": []
    },
    {
      "id": "normalization-engine",
      "name": "NormalizationEngine",
      "role": "Filters invalid quotes and enforces canonical shape",
      "entry_point": "backend/app/engines/normalization_engine.py:normalize_quotes()",
      "package": "backend/app/engines",
      "states_owned": ["quotes_normalized"]
    },
    {
      "id": "quote-ingestion-uow",
      "name": "SqlAlchemyQuoteIngestionUnitOfWork",
      "role": "Persists quotes and workflow events in a single transaction",
      "entry_point": "backend/app/infrastructure/persistence/quote_ingestion_uow.py:persist_quotes()",
      "package": "backend/app/infrastructure/persistence",
      "states_owned": ["quotes_persisted"]
    },
    {
      "id": "logging-publisher",
      "name": "LoggingWorkflowEventPublisher",
      "role": "Publishes workflow events after commit",
      "entry_point": "backend/app/infrastructure/publishers/logging_publisher.py:publish()",
      "package": "backend/app/infrastructure/publishers",
      "states_owned": []
    }
  ],

  "edges": [
    {
      "from": "quote-ingestion-service",
      "to": "in-memory-quote-provider",
      "data_type": "str (event_id)",
      "description": "Request quotes for a specific event",
      "method": "function_call"
    },
    {
      "from": "in-memory-quote-provider",
      "to": "quote-ingestion-service",
      "data_type": "list[Quote]",
      "description": "Raw quotes from provider",
      "method": "function_call"
    },
    {
      "from": "quote-ingestion-service",
      "to": "normalization-engine",
      "data_type": "list[Quote]",
      "description": "Raw quotes to be filtered and validated",
      "method": "function_call"
    },
    {
      "from": "normalization-engine",
      "to": "quote-ingestion-service",
      "data_type": "list[Quote]",
      "description": "Filtered canonical quotes",
      "method": "function_call"
    },
    {
      "from": "quote-ingestion-service",
      "to": "quote-ingestion-uow",
      "data_type": "list[Quote]",
      "description": "Normalized quotes for persistence",
      "method": "function_call"
    },
    {
      "from": "quote-ingestion-uow",
      "to": "quote-ingestion-service",
      "data_type": "QuoteRefreshPersistenceResult",
      "description": "Persistence outcome with market/quote counts",
      "method": "function_call"
    },
    {
      "from": "quote-ingestion-service",
      "to": "logging-publisher",
      "data_type": "tuple[WorkflowEvent]",
      "description": "Committed workflow events for publishing",
      "method": "function_call"
    }
  ],

  "transitions": [
    {
      "step": 1,
      "from_state": null,
      "to_state": "provider_quotes_fetched",
      "service": "quote-ingestion-service",
      "code_ref": "backend/app/application/quote_ingestion_service.py:48",
      "description": "Raw quotes retrieved from provider for the event"
    },
    {
      "step": 2,
      "from_state": "provider_quotes_fetched",
      "to_state": "quotes_normalized",
      "service": "normalization-engine",
      "code_ref": "backend/app/engines/normalization_engine.py:5",
      "description": "Invalid quotes filtered by event, selection, market rules"
    },
    {
      "step": 3,
      "from_state": "quotes_normalized",
      "to_state": "quotes_persisted",
      "service": "quote-ingestion-uow",
      "code_ref": "backend/app/infrastructure/persistence/quote_ingestion_uow.py:67",
      "description": "Quotes upserted to latest, appended to history, events staged"
    },
    {
      "step": 4,
      "from_state": "quotes_persisted",
      "to_state": "events_published",
      "service": "logging-publisher",
      "code_ref": "backend/app/application/quote_ingestion_service.py:79",
      "description": "Workflow events published after successful DB commit"
    }
  ],

  "decisions": [
    {
      "title": "Persist and publish after commit",
      "doc": "docs/flows/_decisions/2026-08-25-persist-and-publish-after-commit.md",
      "date": "2026-08-25"
    },
    {
      "title": "Latest plus history persistence",
      "doc": "docs/flows/_decisions/2026-08-25-latest-plus-history-persistence.md",
      "date": "2026-08-25"
    }
  ],

  "issues": [
    {
      "id": "ISSUE-001",
      "severity": "moderate",
      "category": "no idempotency",
      "description": "Repeated refresh for same event_id appends duplicate history rows",
      "status": "open",
      "code_ref": "backend/app/infrastructure/persistence/quote_ingestion_uow.py:97-105",
      "decision_ref": null
    },
    {
      "id": "ISSUE-002",
      "severity": "moderate",
      "category": "no retry",
      "description": "Provider fetch has no retry/backoff; transient failure fails the request",
      "status": "open",
      "code_ref": "backend/app/application/quote_ingestion_service.py:48",
      "decision_ref": null
    },
    {
      "id": "ISSUE-003",
      "severity": "moderate",
      "category": "concurrency",
      "description": "No lock on market upsert — concurrent refreshes could race",
      "status": "open",
      "code_ref": "backend/app/infrastructure/persistence/quote_ingestion_uow.py:151-176",
      "decision_ref": null
    },
    {
      "id": "ISSUE-004",
      "severity": "low",
      "category": "hardcoded config",
      "description": "InMemoryQuoteProvider uses hardcoded fixture data",
      "status": "open",
      "code_ref": "backend/app/infrastructure/quote_provider.py:6",
      "decision_ref": null
    },
    {
      "id": "ISSUE-005",
      "severity": "low",
      "category": "missing validation",
      "description": "No staleness check on quotes before persistence",
      "status": "open",
      "code_ref": "backend/app/engines/normalization_engine.py:5",
      "decision_ref": null
    }
  ],

  "deeplinks": {
    "models": [
      { "name": "Quote", "path": "backend/app/domain/models.py" },
      { "name": "PersistedQuote", "path": "backend/app/domain/models.py" },
      { "name": "QuoteRefreshPersistenceResult", "path": "backend/app/domain/models.py" },
      { "name": "QuoteRefreshSummary", "path": "backend/app/domain/models.py" }
    ],
    "logic": [
