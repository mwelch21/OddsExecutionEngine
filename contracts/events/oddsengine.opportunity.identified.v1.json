{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwelch21/OddsExecutionEngine/blob/development/contracts/events/oddsengine.opportunity.identified.v1.json",
  "title": "oddsengine.opportunity.identified.v1",
  "description": "A watch's target price became fillable. One event per opportunity, however many books match. CloudEvents 1.0 structured mode (ADR-014). Adding a field keeps v1; removing or changing one is v2.",
  "type": "object",
  "required": ["id", "source", "specversion", "type", "time", "subject", "dataschema", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Unique per event. Consumers dedupe on it (ADR-015)." },
    "source": { "const": "/oddsengine" },
    "specversion": { "const": "1.0" },
    "type": { "const": "oddsengine.opportunity.identified.v1" },
    "time": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "minLength": 1, "description": "The opportunity id." },
    "dataschema": { "type": "string", "format": "uri" },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "nullableDateTime": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "nullableString": { "type": ["string", "null"] },
    "bookPrice": {
      "type": "object",
      "required": ["sportsbook", "price"],
      "properties": {
        "sportsbook": { "type": "string", "minLength": 1 },
        "price": { "type": "integer", "description": "American odds." }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "opportunity_id",
        "watch_intent_id",
        "event",
        "market_type",
        "selection",
        "line",
        "target_price",
        "best",
        "matching"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "minLength": 1 },
        "watch_intent_id": { "type": "string", "minLength": 1 },
        "event": {
          "type": "object",
          "required": ["id", "sport", "league", "home", "away", "starts_at"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sport": { "$ref": "#/$defs/nullableString" },
            "league": { "$ref": "#/$defs/nullableString" },
            "home": { "$ref": "#/$defs/nullableString" },
            "away": { "$ref": "#/$defs/nullableString" },
            "starts_at": { "$ref": "#/$defs/nullableDateTime" }
          }
        },
        "market_type": { "enum": ["moneyline", "spread", "total"] },
        "selection": { "type": "string", "minLength": 1 },
        "line": { "type": ["number", "null"] },
        "target_price": { "type": "integer" },
        "best": {
          "type": "object",
          "required": ["sportsbook", "price", "quoted_at"],
          "properties": {
            "sportsbook": { "type": "string", "minLength": 1 },
            "price": { "type": "integer" },
            "quoted_at": {
              "$ref": "#/$defs/nullableDateTime",
              "description": "The book's own line-movement time (ADR-009). Null means the book does not expose one: unknown age, never fresh."
            }
          }
        },
        "matching": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bookPrice" },
          "description": "Every fillable book, best first."
        }
      }
    }
  }
}
